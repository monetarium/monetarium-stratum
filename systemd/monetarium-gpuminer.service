[Unit]
Description=Monetarium GPU stratum miner
Requires=monetarium-stratum.service
After=monetarium-stratum.service

[Service]
ExecStart=/usr/local/bin/gpuminer \
	--pool 127.0.0.1:5550 \
	--user worker1 \
	--password x \
	--net mainnet \
	--host /usr/local/bin/host \
	--kernels /usr/local/lib/monetarium-gpuminer/cl
Restart=on-failure
RestartSec=5
User=monetarium
Group=monetarium
# The GPU miner caches state in the home directory, so it needs a real home,
# and the render group to open the GPU's /dev entries. Specified explicitly so
# new group membership is picked up regardless of when it was added.
Environment=HOME=/var/local/monetarium
SupplementaryGroups=render

[Install]
WantedBy=multi-user.target
